    {
      "dot": "cyan",
      "title": "Two Generation Paths",
      "items": [
        "REST requests run the LangGraph script → audio workflow.",
        "Telegram webhooks schedule in-process tasks and call the shared generation helpers directly.",
        "The webhook task runs in the app process; no external job queue is configured."
      ]
    },
    {
      "dot": "amber",
      "title": "State and Storage",
      "items": [
        "REST job IDs and Telegram sessions are held in process memory.",
        "Uploads and generated files use the local filesystem; Telegram usage totals use a local JSON file.",
        "The Render configuration runs one Uvicorn worker; no external database or object store is shown."
      ]
    }
