# Comma-separated model IDs populate the API and Telegram model selectors.
# The singular *_MODEL value is the default; users may also enter a custom model.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELS=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Required to enable the Telegram bot webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Maximum download size for Telegram PDF/TXT uploads (default: 20 MiB).
TELEGRAM_MAX_FILE_SIZE=20971520
# Maximum extracted/input text size (default: 200,000 characters).
TELEGRAM_MAX_TEXT_CHARACTERS=200000
TELEGRAM_MAX_AUDIO_SIZE=52428800
TELEGRAM_SESSION_TTL_SECONDS=1800
TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook
# Maximum time allowed for script generation and voice synthesis (default: 30 minutes).
TELEGRAM_JOB_TIMEOUT_SECONDS=1800
